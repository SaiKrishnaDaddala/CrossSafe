<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Vignette overlay — darkens edges above the colored flash background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.35"
        android:importantForAccessibility="no" />

    <!-- Hint bar at top -->
    <LinearLayout
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#55000000"
        android:padding="12dp"
        android:orientation="horizontal"
        android:layout_gravity="top"
        android:visibility="visible">

        <TextView
            android:text="Slide down to stop"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/presetNameText"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Countdown timer -->
    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="120dp"
        android:text="01:30"
        android:textColor="#80FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <!-- Preset name toast (shows when cycling) -->
    <TextView
        android:id="@+id/presetNameToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#88000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Brightness bar (right edge) -->
    <LinearLayout
        android:id="@+id/brightnessBar"
        android:layout_width="60dp"
        android:layout_height="200dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#88000000"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/brightnessPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/brightnessProgress"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="#FFFFFF"
            android:thumbTint="#FFFFFF"
            android:rotation="270" />
    </LinearLayout>

    <!-- Stop confirmation overlay — slides up from bottom on single tap -->
    <LinearLayout
        android:id="@+id/stopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6000000"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp"
        android:translationY="800dp"
        android:elevation="8dp"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#55FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop flashing?"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnStopConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="STOP FLASHING"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#CC2222"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Keep Going"
            android:textColor="#CCFFFFFF"
            android:background="@android:color/transparent" />

    </LinearLayout>

</FrameLayout>

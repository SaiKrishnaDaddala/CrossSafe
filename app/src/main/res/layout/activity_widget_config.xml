<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        app:titleTextColor="@color/colorText"
        app:navigationIconTint="@color/colorText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:text="Widget type"
                android:textColor="@color/colorText"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rgWidgetType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbQuickGo"
                    android:text="Quick GO (1×1)"
                    android:textColor="@color/colorText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbPresetStrip"
                    android:text="Preset Strip (2×1)"
                    android:textColor="@color/colorText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <RadioButton
                    android:id="@+id/rbFullWidget"
                    android:text="Full Widget (2×2)"
                    android:textColor="@color/colorText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveWidget"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save widget"
                android:textAllCaps="false"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
